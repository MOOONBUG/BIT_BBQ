{
  "name": "mooon-enquiries",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "mooonstoreclinic.top/api/*",
      "zone_id": "20dd455633f59fef6dfbe56f6d23fbc4"
    },
    {
      "pattern": "www.mooonstoreclinic.top/api/*",
      "zone_id": "20dd455633f59fef6dfbe56f6d23fbc4"
    }
  ],
  "compatibility_date": "2024-11-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "observability": {
    "enabled": true
  },
  "main": "worker/index.ts",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mooon-enquiries",
      "database_id": "df2be91e-7e6d-4928-8565-c3d13d810148",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ENQUIRIES_ENABLED": "true",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFAzR0Z6NNgcMCe9",
    "ALLOWED_HOSTS": "mooonstoreclinic.top,www.mooonstoreclinic.top",
    "RETENTION_DAYS": "90",
    "NOTIFICATIONS_ENABLED": "true",
    "NOTIFICATIONS_START_AT": "1790178975",
    "ZOHO_REGION": "com",
    "ZOHO_ACCOUNT_ID": "8336391000000008002",
    "NOTIFICATION_FROM": "hello@mooonstoreclinic.top",
    "NOTIFICATION_TO": "hello@mooonstoreclinic.top"
  },
  "triggers": {
    "crons": [
      "15 2 * * *",
      "*/5 * * * *"
    ]
  },
  "account_id": "103fd401716c51514727e56df9cf046f",
  "secrets": {
    "required": [
      "TURNSTILE_SECRET_KEY",
      "RATE_LIMIT_SECRET",
      "ZOHO_CLIENT_ID",
      "ZOHO_CLIENT_SECRET",
      "ZOHO_REFRESH_TOKEN"
    ]
  }
}
