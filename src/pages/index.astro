---
import Site from '../layouts/Site.astro';
import { business } from '../site';
import { useLocale } from '../i18n';
const { t, href } = useLocale(Astro.url);
const notes = [
    [t('m031'), t('m091')],
    [t('m092'), t('m093')],
    [t('m094'), t('m095')]
  ];
const reports = [
  [t('m051'), t('m052')],
  [t('m096'), t('m097')],
  [t('m098'), t('m099')]
];
const demoCopy = { notes, values: [t('m023'), t('m100'), t('m101'), t('m102'), t('m024'), t('m103'), t('m025'), t('m104'), t('m030'), t('m105')] };
---
<Site>
<section class="hero wrap">
<div class="hero-copy"><p class="eyebrow">{t('m011')}</p><h1>{t('m012')}<br/><em>{t('m013')}</em></h1><p class="lede">{t('m014')}</p><div class="actions"><a class="button" href={href("/contact/")}>{t('m015')} <span aria-hidden="true">↗</span></a><a class="text-link" href={href("/sample/")}>{t('m016')}</a></div></div>
<aside class="review-preview interactive-review" data-review-copy={JSON.stringify(demoCopy)} aria-label={t('m087')}>
<div class="preview-heading"><img src="/brand/mark.svg" width="44" height="44" alt=""/><span>{t('m017')}</span><span class="lab-label">{t('m018')}</span></div>
<div class="demo-controls" hidden><div class="view-toggle" role="group" aria-label={t('m088')}><button type="button" data-view="before" aria-pressed="true">{t('m019')}</button><button type="button" data-view="after" aria-pressed="false">{t('m020')}</button></div></div>
<div class="demo-stage" data-mode="before"><div class="product-visual" aria-hidden="true"><span class="product-word">everyday.</span><div class="cup-object"><span>every<br/>day.</span></div><span class="product-caption">{t('m021')}</span></div><div class="demo-product"><span class="preview-label">{t('m022')}</span><h2 id="demo-title">{t('m023')}</h2><p class="demo-price" id="demo-price">$18</p><p id="demo-detail">{t('m024')}</p><div class="demo-cart" id="demo-cart">{t('m025')}</div><small>{t('m026')}</small></div></div>
<div class="hotspots" hidden role="group" aria-label={t('m089')}><button type="button" data-finding="0" aria-pressed="true">{t('m027')}</button><button type="button" data-finding="1" aria-pressed="false">{t('m028')}</button><button type="button" data-finding="2" aria-pressed="false">{t('m029')}</button></div>
<div class="finding-note" aria-live="polite" aria-atomic="true"><span id="finding-label">{t('m030')}</span><p id="finding-text">{t('m031')}</p></div>
<p class="preview-caption">{t('m032')}</p><noscript><p class="preview-caption"><a href={href("/sample/")}>{t('m033')}</a></p></noscript></aside>
</section>
<section class="wrap service-section section" id="service"><div class="section-heading"><p class="eyebrow">{t('m034')}</p><h2>{t('m035')}<br/>{t('m036')}</h2><p>{t('m037')}</p><a class="text-link" href={href("/about/")}>{t('m038')}</a></div><div class="review-topics"><article><span class="topic-number">01</span><div><h3>{t('m039')}</h3><p>{t('m040')}</p></div></article><article><span class="topic-number">02</span><div><h3>{t('m041')}</h3><p>{t('m042')}</p></div></article><article><span class="topic-number">03</span><div><h3>{t('m043')}</h3><p>{t('m044')}</p></div></article></div></section>
<section class="wrap deliverable-section"><div class="section-heading"><p class="eyebrow">{t('m045')}</p><h2>{t('m046')}<br/>{t('m047')}</h2></div><div class="deliverable-controls" hidden role="group" aria-label={t('m090')}><button type="button" data-report="0" aria-pressed="true">{t('m048')}</button><button type="button" data-report="1" aria-pressed="false">{t('m049')}</button><button type="button" data-report="2" aria-pressed="false">{t('m050')}</button></div><div class="deliverable-panel" data-report-copy={JSON.stringify(reports)} aria-live="polite" aria-atomic="true"><span id="report-number" aria-hidden="true">01</span><div><h3 id="report-title">{t('m051')}</h3><p id="report-description">{t('m052')}</p><a class="text-link" href={href("/sample/")}>{t('m053')}</a></div></div></section>
<section class="offer wrap"><div><p class="eyebrow">{t('m054')}</p><h2>{t('m055')}<br/>{t('m056')}</h2><ul class="checks"><li>{t('m057')}</li><li>{t('m058')}</li><li>{t('m059')}</li><li>{t('m060')}</li></ul></div><div class="price"><span>{t('m061')}</span><strong>{business.price}</strong><p>{t('m062')}</p><a class="button" href={href("/contact/")}>{t('m063')}</a><small>{t('m064')}</small></div></section>
<section class="wrap section process"><div class="section-heading"><h2>{t('m065')}</h2></div><div class="steps"><article><span class="step-number">01</span><h3>{t('m066')}</h3><p>{t('m067')}</p></article><article><span class="step-number">02</span><h3>{t('m068')}</h3><p>{t('m069')}</p></article><article><span class="step-number">03</span><h3>{t('m070')}</h3><p>{t('m071')}</p></article></div></section>
<section class="wrap safety"><div><h2>{t('m072')}<br/>{t('m073')}</h2></div><p>{t('m074')}</p></section>
<section class="wrap section faq"><h2>{t('m075')}</h2><details><summary>{t('m076')}</summary><p>{t('m077')}</p></details><details><summary>{t('m078')}</summary><p>{t('m079')}</p></details><details><summary>{t('m080')}</summary><p>{t('m081')}</p></details><details><summary>{t('m082')}</summary><p>{t('m083')}</p></details></section>
<section class="closing wrap"><img src="/brand/mark.svg" width="80" height="80" alt=""/><h2>{t('m084')}<br/><em>{t('m085')}</em></h2><a class="button" href={href("/contact/")}>{t('m086')}</a></section>
<script>
const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
const demo = document.querySelector<HTMLElement>('.interactive-review');
if (demo) {
  demo.querySelectorAll<HTMLElement>('[hidden]').forEach(el => el.hidden = false);
  let after = false;
  let finding = 0;
  const { notes, values } = JSON.parse(demo.dataset.reviewCopy!) as { notes: string[][]; values: string[] };
  const setText = (id: string, value: string) => { const el = document.getElementById(id); if (el) el.textContent = value; };
  const update = () => {
    setText('demo-title', after ? values[1] : values[0]);
    setText('demo-price', after ? values[3] : values[2]);
    setText('demo-detail', after ? values[5] : values[4]);
    setText('demo-cart', after ? values[7] : values[6]);
    setText('finding-label', after ? values[9] : values[8]);
    setText('finding-text', notes[finding][after ? 1 : 0]);
    demo.querySelector<HTMLElement>('.demo-stage')!.dataset.mode = after ? 'after' : 'before';
    demo.querySelectorAll<HTMLButtonElement>('[data-view]').forEach(b => b.setAttribute('aria-pressed', String((b.dataset.view === 'after') === after)));
    demo.querySelectorAll<HTMLButtonElement>('[data-finding]').forEach(b => b.setAttribute('aria-pressed', String(Number(b.dataset.finding) === finding)));
    if (!reduced.matches) demo.querySelector('.demo-product')?.animate([{opacity:.45,transform:'translateY(8px)'},{opacity:1,transform:'translateY(0)'}],{duration:320,easing:'ease-out'});
  };
  demo.querySelectorAll<HTMLButtonElement>('[data-view]').forEach(b => b.addEventListener('click', () => {after = b.dataset.view === 'after'; update();}));
  demo.querySelectorAll<HTMLButtonElement>('[data-finding]').forEach(b => b.addEventListener('click', () => {finding = Number(b.dataset.finding); update();}));
}
const reports = JSON.parse(document.querySelector<HTMLElement>('[data-report-copy]')!.dataset.reportCopy!) as string[][];
const controls = document.querySelector<HTMLElement>('.deliverable-controls');
if (controls) controls.hidden = false;
document.querySelectorAll<HTMLButtonElement>('[data-report]').forEach(b => b.addEventListener('click', () => {
  const n = Number(b.dataset.report);
  document.getElementById('report-title')!.textContent = reports[n][0];
  document.getElementById('report-description')!.textContent = reports[n][1];
  document.getElementById('report-number')!.textContent = '0' + (n + 1);
  document.querySelectorAll<HTMLButtonElement>('[data-report]').forEach(item => item.setAttribute('aria-pressed', String(item === b)));
  if (!reduced.matches) document.querySelector('.deliverable-panel')?.animate([{opacity:.3,transform:'translateY(12px)'},{opacity:1,transform:'translateY(0)'}],{duration:360,easing:'ease-out'});
}));
if ('IntersectionObserver' in window) {
  const observer = new IntersectionObserver(entries => entries.forEach(entry => {
    if (!entry.isIntersecting) return;
    observer.unobserve(entry.target);
    if (!reduced.matches) entry.target.animate([{opacity:.15,transform:'translateY(28px)'},{opacity:1,transform:'translateY(0)'}],{duration:650,easing:'cubic-bezier(.2,.7,.2,1)'});
  }),{threshold:.12});
  document.querySelectorAll('.review-topics article, .offer, .steps article, .deliverable-section, .safety, .closing').forEach(el => observer.observe(el));
}
</script>
</Site>
