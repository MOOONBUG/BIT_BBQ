---
import Site from '../layouts/Site.astro';
import BriefBuilder from '../components/BriefBuilder.astro';
import { useLocale } from '../i18n';
import { microCopy } from '../i18n/micro';
import { microReview } from '../../shared/services';
import { business } from '../site';
const { locale, href, t } = useLocale(Astro.url);
const m = microCopy[locale];
---
<Site title={`${m.nav} | MooonStoreClinic`} description={m.lead}>
<section class="wrap quick-hero">
  <div><p class="eyebrow">{m.nav}</p><h1>{m.title}</h1><p class="lede">{m.lead}</p><div class="actions"><a class="button" href="#application">{m.apply} <span aria-hidden="true">→</span></a></div><p class="micro">{m.benefits}</p></div>
  <aside class="quick-example"><p class="eyebrow">{m.sample}</p><h2>{m.sampleTitle}</h2><div class="quick-mock"><p>Everyday tote</p><strong>$32</strong><div class="quick-cart">{m.cart}</div><p class="quick-annotation">① {m.observation}</p></div><p>{m.recommendation}</p><p>{m.validation}</p><p class="micro">{m.sampleDisclaimer}</p></aside>
</section>
<div class="wrap quick-layout">
<section><h2>{m.scopeTitle}</h2><p>{m.scope}</p><p>{m.exclusions}</p><div class="notice"><b data-weekly-limit={m.language}>{m.language.replace('{limit}', String(microReview.weeklyLimit))}</b><p>{m.selection}</p></div><p>{m.followup}</p><h3>{m.paidTitle}</h3><p>{m.paid}</p><a class="text-link" href={href('/contact/')}>{t('m004')}</a><hr/><p class="micro">{m.privacy} <a href={href('/privacy/')}>{t('enquiryPrivacy')}</a></p></section>
<section id="application"><BriefBuilder service="free_trial" /><noscript><p>{m.fallback}</p></noscript><p class="micro"><a href={`mailto:${business.email}?subject=${encodeURIComponent(m.subject)}`}>{business.email}</a></p></section>
</div>
</Site>
<style>
.quick-hero{display:grid;grid-template-columns:1.1fr 1fr;gap:60px;align-items:center;padding-block:65px}.quick-hero>*,.quick-layout>*{min-width:0}.quick-hero h1{font-size:clamp(2.2rem,4.5vw,4.2rem)}.quick-example{background:var(--mint);border-radius:26px;padding:28px;box-shadow:0 10px 0 #cdd5b5}.quick-example h2{font-size:26px}.quick-example p{font-size:15px}.quick-example .eyebrow,.quick-example .micro{font-size:12px}.quick-mock{padding:20px;border:1px solid var(--line);background:#fffdf7;border-radius:16px;margin-bottom:20px}.quick-cart{text-align:center;background:var(--ink);color:var(--paper);padding:10px;border-radius:12px;margin-top:12px}.quick-annotation{border:2px dashed var(--accent);padding:10px;margin:10px 0 0!important}.quick-layout{display:grid;grid-template-columns:1fr 1.15fr;gap:45px;padding-block:35px 80px}.quick-layout h2{font-size:32px}.quick-layout h3{font-size:24px;margin-top:35px}.quick-layout :global(.brief-builder){margin-top:0}.quick-layout :global(p),.quick-hero p{overflow-wrap:anywhere}.quick-layout hr{border:0;border-top:1px solid var(--line);margin-top:32px}@media(max-width:900px){.quick-hero,.quick-layout{grid-template-columns:1fr;gap:32px}.quick-hero{padding-block:38px}.quick-example{max-width:650px}.quick-layout{padding-top:20px}.quick-hero h1{font-size:clamp(2rem,7vw,3.6rem)}}
</style>
