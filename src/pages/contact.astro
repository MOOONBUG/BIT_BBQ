---
import Site from '../layouts/Site.astro';
import { business } from '../site';
const hasContact = Boolean(business.email || business.whatsapp);
import { useLocale } from '../i18n';
const { t, href } = useLocale(Astro.url);
---
<Site title={t('m158')}><section class="wrap prose section"><p class="eyebrow">{t('m139')}</p><h1>{t('m140')}</h1><p class="lede">{t('m141')}</p>{hasContact ? <div class="actions">{business.email && <a class="button" href={`mailto:${business.email}?subject=${encodeURIComponent(t('enquirySubject'))}`}>{t('m142')}</a>}{business.whatsapp && <a class="text-link" href={business.whatsapp} target="_blank" rel="noopener noreferrer">{t('m143')}</a>}</div> : <aside class="notice"><b>{t('m144')}</b><p>{t('m145')}</p></aside>}{business.email && <p>{t('m146')} <a href={`mailto:${business.email}`} style="overflow-wrap: anywhere">{business.email}</a></p>}<h2>{t('m147')}</h2><p>{t('m148')}</p><ol><li>{t('m149')}</li><li>{t('m150')}</li><li>{t('m151')}</li><li>{t('m152')}</li><li>{t('m153')}</li></ol><a class="text-link" href={href("/review-brief.txt")} download>{t('m154')}</a><p class="micro">{t('m155')}</p><h2>{t('m156')}</h2><p>{t('m157')}</p></section></Site>