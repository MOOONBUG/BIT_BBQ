---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { useLocale, languages } from '../i18n';
const { locale, t } = useLocale(Astro.url);
const { title = t('siteTitle'), description = t('siteDescription') } = Astro.props;
---
<!doctype html><html lang={languages[locale].tag}><head><BaseHead title={title} description={description}/></head><body><a href="#main" class="skip">{t('skip')}</a><Header/><main id="main"><slot/></main><Footer/></body></html>