---
import { useLocale } from '../i18n';
import { business } from '../site';
import { microCopy } from '../i18n/micro';
import { microReview } from '../../shared/services';
const { t, locale, href } = useLocale(Astro.url);
const trial = Astro.props.service === microReview.type;
const m = microCopy[locale];
const labels = [t('enquiryEmail'), t('brief1'), t('brief2'), t('brief3'), t('brief4'), t('brief5')];
const copy = { serviceType: trial ? microReview.type : 'paid_enquiry', policyVersion: trial ? microReview.policyVersion : '', configPath: trial ? '/api/free-reviews/config' : '/api/enquiries/config', price: trial ? m.fee : 'USD 60', paused: m.paused, labels, locale, title: trial ? m.subject : t('briefTitle'), scope: trial ? m.nav : t('briefScope'), details: trial ? [m.scope,m.exclusions,m.followup] : [t('m057'), t('m058'), t('m059'), t('m060')], fee: t('m061'), delivery: trial ? m.delivery : t('m062'), terms: trial ? m.terms : t('m064'), copied: t('briefCopied'), copyError: t('briefCopyError'), urlError: t('briefUrlError'), subject: trial ? m.subject : t('enquirySubject'), email: business.email, sending: t('enquirySending'), unknown: t('enquiryUnknown'), invalid: t('enquiryInvalid'), verification: t('enquiryVerification'), rate: t('enquiryRate'), unavailable: t('enquiryUnavailable'), conflict: t('enquiryConflict'), consent: t('enquiryConsentError'), fallback: trial ? m.fallback : t('briefLocal'), online: trial ? m.online : t('enquiryOnline') };
---
<section class="brief-builder" hidden data-brief={JSON.stringify(copy)} aria-labelledby="brief-heading">
  <div class="brief-progress" aria-hidden="true"><span data-step-label>01</span> / <span data-step-total>02</span></div>
  <h2 id="brief-heading">{trial ? m.formTitle : t('m147')}</h2>
  <p>{trial ? m.selection : t('enquiryIntro')}</p>
  <form id="brief-form">
<label for="brief-contact">{t('enquiryEmail')}<input id="brief-contact" name="email" type="email" autocomplete="email" required maxlength="254" /></label>
    <label for="brief-url">{t('m149')}<input id="brief-url" name="pageUrl" type="url" inputmode="url" placeholder="https://your-store.com/products/example" required maxlength="500" autocomplete="url" aria-describedby="brief-url-error"/><span id="brief-url-error" class="field-error" aria-live="polite"></span></label>
    <label for="brief-market">{t('m150')}<input id="brief-market" name="market" type="text" required maxlength="160"/></label>
    <label for="brief-goal">{t('m151')}<textarea id="brief-goal" name="goal" required maxlength="400" rows="3"></textarea></label>
    {!trial && <><label for="brief-issue">{t('m152')} <small>({t('briefOptional')})</small><textarea id="brief-issue" name="issue" maxlength="400" rows="3"></textarea></label>
    <label for="brief-time">{t('m153')} <small>({t('briefOptional')})</small><input id="brief-time" name="preferredTime" type="text" maxlength="160"/></label>
    </>}
    <button class="button" type="submit">{t('briefReview')}</button>
  </form>
  <div id="brief-summary" hidden>
    <h3 id="brief-summary-heading" tabindex="-1">{t('briefSummary')}</h3>
    <div class="brief-scope"><b>{trial ? m.nav : t('briefScope')}</b><p>{trial ? m.scope : t('m057')}</p><strong>{trial ? m.fee : 'USD 60'}</strong><p>{trial ? m.delivery : t('m062')}</p><small>{trial ? m.exclusions : t('m064')}</small></div>
    <pre id="brief-output" tabindex="0"></pre>
    <div id="brief-direct" hidden><label class="brief-consent"><input type="checkbox" id="brief-ack"/><span>{trial ? m.consent : t('enquiryConsent')} <a href={href('/privacy/')} target="_blank" rel="noopener noreferrer">{t('enquiryPrivacy')}</a></span></label><div id="brief-challenge"></div></div>
<div class="actions"><button class="button" id="brief-send" type="button" hidden>{t('enquirySubmit')}</button><a class="secondary-button" id="brief-email" href={`mailto:${business.email}`}>{t('briefEmail')}</a><button class="secondary-button" id="brief-copy" type="button">{t('briefCopy')}</button><button class="text-button" id="brief-edit" type="button">{t('briefEdit')}</button></div>
    <p id="brief-status" class="micro" role="status"></p>
  </div>
  <div id="brief-received" class="brief-scope" hidden><h3 tabindex="-1" id="brief-received-heading">{trial ? m.received : t('enquiryReceived')}</h3><p class="micro">{t('enquiryReference')}</p><p id="brief-reference"></p><p>{trial ? m.next : t('enquiryNext')}</p><p class="micro">{trial ? m.notOrder : t('enquiryNotOrder')}</p></div>
<p class="micro" id="brief-mode">{trial ? m.fallback : t('briefLocal')}</p>
  <p class="micro">{t('briefSafe')}</p>
</section>
<script>
import '../scripts/enquiry';
</script>
<style>
.brief-builder .brief-consent{display:flex;align-items:flex-start;gap:12px;font-weight:400;font-size:14px}.brief-builder .brief-consent input{width:20px;min-height:20px;height:20px;flex:none;margin-top:4px}.brief-builder button:disabled{opacity:.6;cursor:wait}#brief-reference{font:700 15px/1.6 monospace;overflow-wrap:anywhere}#brief-challenge{min-height:65px;margin-block:20px}#brief-status{min-height:24px;white-space:pre-wrap}
</style>
