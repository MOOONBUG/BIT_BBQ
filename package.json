{
  "name": "mooonstoreclinic",
  "description": "MooonStoreClinic storefront review and optimization service website.",
  "dependencies": {
    "@astrojs/cloudflare": "12.1.0",
    "@astrojs/mdx": "4.0.3",
    "@astrojs/rss": "4.0.11",
    "@astrojs/sitemap": "3.2.1",
    "astro": "5.1.3",
    "typescript": "5.7.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260923.1",
    "wrangler": "4.136.3"
  },
  "scripts": {
    "astro": "astro",
    "build": "astro build",
    "check": "astro build && tsc && wrangler deploy --dry-run",
    "deploy": "astro build && wrangler deploy",
    "dev": "astro dev",
    "preview": "astro build && wrangler dev",
    "types": "wrangler types --config wrangler.api.json --strict-vars=false",
    "test": "node tests/receiver.cjs",
    "deploy:api": "wrangler deploy --config wrangler.api.json",
    "deploy:all": "npm run deploy && npm run deploy:api"
  },
  "type": "module"
}
